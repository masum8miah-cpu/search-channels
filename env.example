# GitHub access.
# Required in Render/local runtime. Do NOT commit a real token here.
GITHUB_TOKEN=
GITHUB_OWNER=masum8miah-cpu
TARGET_REPO=my-ip-tv
TARGET_BRANCH=main

# Latest Brightis.m3u is fetched at the beginning of every run.
SOURCE_PLAYLIST=Brightis.m3u
SEARCH_OUTPUT=সার্চ কালেকশন.m3u
LIVE_OUTPUT=live-event-channel-colector.m3u

# Free general-web search.
# Firecrawl Keyless needs no API key or card. It has a monthly free-credit limit.
FIRECRAWL_ENABLED=true
FIRECRAWL_RESULTS=5
FIRECRAWL_TIMEOUT_MS=30000

# No-key fallback search.
DDG_ENABLED=true
DDG_TIMEOUT_MS=15000
MIN_WEB_RESULTS=3

# Optional legacy Google Custom Search.
# Leave disabled unless you already have a working API key + CX.
GOOGLE_ENABLED=false
GOOGLE_API_KEY=
GOOGLE_CX=

# Search and verification controls.
GITHUB_ENABLED=true
URL_CHECK_TIMEOUT_MS=10000
WEB_PAGE_TIMEOUT_MS=12000
SEARCH_DELAY_MS=700
MAX_RESULTS_PER_CHANNEL=10
MAX_LIVE_RESULTS=200
LIVE_QUERIES=live sports m3u8,live cricket m3u8,live football m3u8,live event m3u8,live tv m3u8

# Runtime.
PORT=10000
NODE_ENV=production
USER_AGENT=search-channels/1.0
